        "language": "javaScript",
        "jsCode": "const r = $json || {};\nconst p = $('Preparar registro').first().json;\nconst origem = r.status === 'concluida' ? 'pesquisa' : (r.status === 'sem_dado' ? 'sem_dado' : 'erro');\nreturn [{ json: {\n  ok: origem !== 'erro',\n  origem: origem,\n  status: origem,\n  confianca: r.confianca || null,\n  fontes: r.fontes || 0,\n  mediana: r.mediana || null,\n  minimo: r.minimo || null,\n  maximo: r.maximo || null,\n  duracao_ms: p.p_duracao_ms,\n  consulta_id: p.p_consulta,\n  estourou_tempo: p.estourou,\n  tokens_estimados: p.p_tokens,\n  requisicoes: p.p_requisicoes,\n} }];"
