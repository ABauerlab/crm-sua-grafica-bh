    {
      "id": "60cab1ce-2a3d-dcda-2a1f-fcb7d10219a7",
      "name": "Extrair preço com modelo (último recurso)",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        2640,
        160
      ],
      "parameters": {
        "text": "={{ $json.texto_para_modelo }}",
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"fontes\":[{\"url\":\"https://exemplo.com.br/produto\",\"preco_total_brl\":125.9,\"quantidade\":1000,\"mesma_especificacao\":true}]}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "baf38234-e833-4dc4-2b27-3b8e7fbf1e31",
      "name": "Validar saída do modelo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const base = $('Consolidar fontes').first().json;\nconst saida = ($json.output && Array.isArray($json.output.fontes)) ? $json.output.fontes : [];\nconst fontes = [];\nlet tokens = 0;\nfor (const t of base.textos) { tokens += Math.ceil(t.texto.length / 3.5) + 250; }\nfor (const s of saida) {\n  const alvo = base.textos.find(function (t) { return t.url === s.url; }) || base.textos[0];\n  const preco = Number(s.preco_total_brl);\n  if (!(preco > 0) || s.mesma_especificacao !== true || !alvo) continue;\n  const partes = preco.toFixed(2).split('.');\n  const milhar = partes[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.') + ',' + partes[1];\n  const simples = partes[0] + ',' + partes[1];\n  if (alvo.texto.indexOf(milhar) < 0 && alvo.texto.indexOf(simples) < 0) continue;\n  fontes.push({ fonte: alvo.host, url: alvo.url, preco: preco, quantidade: Number(s.quantidade) || null, descricao: (base.especificacao && base.especificacao.descricao) || '', mesma_especificacao: true, texto: 'modelo: ' + milhar });\n}\nreturn [{ json: Object.assign({}, base, { fontes: fontes, tokens: tokens, metodo: 'modelo' }) }];"
      }
    },
