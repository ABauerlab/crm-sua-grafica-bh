        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const pag = $('Para cada página').item.json;\nconst cache = $('Consultar cache').first().json;\nconst esp = cache.especificacao || {};\nconst j = $json || {};\nlet bruto = '';\nif (typeof j.texto === 'string') bruto = j.texto;\nelse if (j.data && typeof j.data === 'object' && typeof j.data.markdown === 'string') bruto = j.data.markdown;\nelse if (typeof j.data === 'string') bruto = j.data;\nconst texto = bruto.replace(/<script[\\s\\S]*?<\\/script>/gi, ' ').replace(/<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').slice(0, 30000);\nconst base = { host: pag.host, url: pag.url, metodo: 'regex', chars: texto.length };\nif (texto.length < 80) return { json: Object.assign(base, { mesma_especificacao: false, preco: null, bloqueado: 'pagina_vazia_ou_sem_js', precisa_modelo: false, texto_trunc: '' }) };\nconst precos = [];\nconst reP = /R\\$\\s*(\\d{1,3}(?:\\.\\d{3})*,\\d{2})/g;\nlet mm;\nwhile ((mm = reP.exec(texto)) !== null) { precos.push({ pos: mm.index, valor: Number(mm[1].replace(/\\./g, '').replace(',', '.')) }); }\nconst qtd = Number(esp.quantidade) || 0;\nlet posQtd = -1;\nlet fimQtd = -1;\nif (qtd > 1) {\n  const formas = [String(qtd), String(qtd).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.')];\n  for (const f of formas) {\n    const re = new RegExp('(^|[^0-9.,])' + f.replace(/\\./g, '\\\\.') + '(?![0-9,])');\n    const m2 = re.exec(texto);\n    if (m2) { posQtd = m2.index + m2[1].length; fimQtd = m2.index + m2[0].length; break; }\n  }\n}\nconst desc = ((esp.descricao || '') + ' ' + (esp.grupo || '')).toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst exigidos = [];\nif (esp.gramatura_g) exigidos.push(new RegExp('(^|[^0-9])' + esp.gramatura_g + '\\\\s?g', 'i'));\nconst papeis = ['couche', 'fosco', 'brilho', 'kraft', 'reciclato', 'vinil', 'lona', 'verniz', 'supreme', 'offset', 'transparente', 'branco'];\nfor (const p of papeis) { if (desc.indexOf(p) >= 0) exigidos.push(new RegExp(p, 'i')); }\nconst medidas = String(esp.tamanho_mm || '').match(/\\d+/g) || [];\nif (medidas.length >= 2) {\n  const cm = function (n) { return String(Number(n) / 10).replace('.', ','); };\n  const a = medidas[0]; const b = medidas[1];\n  exigidos.push(new RegExp('(' + a + '\\\\s?x\\\\s?' + b + '|' + b + '\\\\s?x\\\\s?' + a + '|' + cm(a) + '\\\\s?x\\\\s?' + cm(b) + '|' + cm(b) + '\\\\s?x\\\\s?' + cm(a) + ')', 'i'));\n}\nconst atributosOk = exigidos.every(function (r) { return r.test(texto); });\nlet escolhido = null;\nif (posQtd >= 0) {\n  const proxima = /\\d[\\d.]*\\s*(unidades|unidade|unid\\.?|und\\.?|un\\b)/i.exec(texto.slice(fimQtd + 12));\n  const limite = proxima ? fimQtd + 12 + proxima.index : fimQtd + 250;\n  for (const p of precos) {\n    if (p.pos >= fimQtd && p.pos < limite && p.pos - fimQtd <= 250) { escolhido = p; break; }\n  }\n}\nconst plausivel = escolhido && escolhido.valor >= 5 && escolhido.valor <= 200000;\nconst mesma = !!(posQtd >= 0 && atributosOk && plausivel);\nconst temPreco = precos.length > 0;\nreturn { json: Object.assign(base, {\n  mesma_especificacao: mesma,\n  preco: mesma ? escolhido.valor : null,\n  quantidade: qtd,\n  trecho: mesma ? texto.slice(Math.max(0, escolhido.pos - 120), escolhido.pos + 60) : '',\n  precisa_modelo: !mesma && temPreco,\n  texto_trunc: (!mesma && temPreco) ? texto.slice(0, 3500) : '',\n  bloqueado: temPreco ? null : 'sem_preco_na_pagina',\n}) };"
      }
    },
