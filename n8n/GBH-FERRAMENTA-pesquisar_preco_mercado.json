    {
      "id": "50193a21-6fad-e1a1-326f-89757641782f",
      "name": "Resposta do cache ou sem dado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $json || {};\nconst origem = j.sem_dado ? 'sem_dado' : (j.em_andamento ? 'em_andamento' : (j.cache ? 'cache' : 'erro'));\nreturn [{ json: { ok: origem !== 'erro', origem: origem, status: origem, confianca: j.confianca || null, fontes: j.fontes || 0, mediana: j.mediana || null, minimo: j.minimo || null, maximo: j.maximo || null, duracao_ms: 0, consulta_id: j.consulta_id || null } }];"
      }
    },
    {
      "id": "46ed2abf-fe82-f146-25c5-a955317a7b23",
      "name": "Montar buscas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cache = $('Consultar cache').first().json;\nconst esp = cache.especificacao || {};\nconst partes = [esp.grupo, esp.descricao, esp.quantidade ? esp.quantidade + ' unidades' : '', esp.gramatura_g ? esp.gramatura_g + 'g' : '', esp.tamanho_mm ? esp.tamanho_mm + ' mm' : ''].filter(Boolean);\nconst base = partes.join(' ');\nconst consultas = [\n  { prioridade: 1, query: 'site:www.alfacards.com.br ' + base },\n  { prioridade: 2, query: base + ' preço gráfica online' },\n  { prioridade: 3, query: base + ' preço gráfica Belo Horizonte' },\n];\nreturn consultas.map(c => ({ json: Object.assign({ consulta_id: cache.consulta_id }, c) }));"
      }
    },
