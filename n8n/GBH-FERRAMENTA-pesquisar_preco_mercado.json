        "jsCode": "const j = $json;\nconst cfg = $('Início e configuração').first().json;\nconst fontes = Array.isArray(j.fontes) ? j.fontes : [];\nreturn [{ json: {\n  p_consulta: j.consulta_id,\n  p_fontes: fontes,\n  p_duracao_ms: Date.now() - cfg.t0,\n  p_erro: fontes.length > 0 ? null : (j.estourou ? 'tempo_esgotado' : null),\n  p_tokens: j.tokens || 0,\n  p_requisicoes: j.requisicoes || 0,\n  estourou: !!j.estourou,\n} }];"
      }
    },
