    {
      "id": "f93ad6be-41b1-91f1-9196-1882ff78cf2b",
      "name": "Consolidar fontes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cache = $('Consultar cache').first().json;\nconst cfg = $('Início e configuração').first().json;\nconst itens = $input.all().map(function (i) { return i.json; }).filter(function (i) { return i && i.host; });\nconst fontes = itens.filter(function (i) { return i.mesma_especificacao && i.preco > 0; }).map(function (i) {\n  return { fonte: i.host, url: i.url, preco: i.preco, quantidade: i.quantidade || null, descricao: (cache.especificacao && cache.especificacao.descricao) || '', mesma_especificacao: true, texto: i.trecho || '' };\n});\nconst textos = itens.filter(function (i) { return i.precisa_modelo && i.texto_trunc; }).slice(0, 2).map(function (i) { return { host: i.host, url: i.url, texto: i.texto_trunc }; });\nconst decorrido = Date.now() - cfg.t0;\nconst limite = (cache.timeout_s || 45) * 1000;\nconst bloqueios = itens.filter(function (i) { return i.bloqueado; }).map(function (i) { return i.host + ':' + i.bloqueado; });\nreturn [{ json: {\n  consulta_id: cache.consulta_id,\n  fontes: fontes,\n  textos: textos,\n  usar_modelo: fontes.length === 0 && textos.length > 0,\n  requisicoes: itens.length,\n  decorrido_ms: decorrido,\n  estourou: decorrido >= limite,\n  bloqueios: bloqueios,\n  especificacao: cache.especificacao,\n  texto_para_modelo: 'Regras: extraia somente preços que aparecem literalmente no texto e que sejam da MESMA especificação (quantidade, papel, gramatura, acabamento e tamanho). Na dúvida devolva a lista vazia. Nunca invente valores.\\n\\nEspecificação procurada: ' + JSON.stringify(cache.especificacao) + '\\n\\n' + textos.map(function (t) { return 'URL: ' + t.url + '\\n' + t.texto; }).join('\\n\\n---\\n\\n'),\n} }];"
      }
    },
