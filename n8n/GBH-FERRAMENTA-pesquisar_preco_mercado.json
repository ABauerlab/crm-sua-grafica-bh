    {
      "id": "3e3e40fb-c108-aa45-a2b8-70214c80173b",
      "name": "Escolher páginas (um domínio por vez)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cache = $('Consultar cache').first().json;\nconst cfg = $('Início e configuração').first().json;\nconst limite = (cache.timeout_s || 45) * 1000;\nconst bloqueados = /(facebook|instagram|youtube|tiktok|pinterest|mercadolivre|shopee|olx|amazon|aliexpress|wikipedia|reclameaqui)\\./i;\nconst porDominio = {};\nconst ordem = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const lista = Array.isArray(j.results) ? j.results : (Array.isArray(j.organic) ? j.organic : []);\n  for (const r of lista) {\n    const url = r.url || r.link;\n    if (!url || !/^https?:\\/\\//i.test(url)) continue;\n    const m = /^https?:\\/\\/([^\\/?#:]+)/i.exec(url);\n    if (!m) continue;\n    const host = m[1].toLowerCase();\n    if (bloqueados.test(host + '.')) continue;\n    if (porDominio[host]) continue;\n    porDominio[host] = true;\n    ordem.push({ host: host, url: url, titulo: r.title || '', prioridade: host === 'www.alfacards.com.br' ? 0 : 1 });\n  }\n}\nordem.sort((a, b) => a.prioridade - b.prioridade);\nconst escolhidas = ordem.slice(0, cfg.max_paginas || 5);\nif (escolhidas.length === 0) return [{ json: { url: null, host: null, sem_resultados: true, limite_ms: limite } }];\nreturn escolhidas.map(p => ({ json: Object.assign({ limite_ms: limite }, p) }));"
      }
    },
