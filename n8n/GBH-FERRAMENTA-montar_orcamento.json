      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const itens = $input.first().json.itens || [];\nconst vistos = {};\nconst saida = [];\nfor (const it of itens) {\n  const sku = String((it && it.sku) || '').trim();\n  if (!sku || vistos[sku]) continue;\n  vistos[sku] = true;\n  saida.push({ json: { sku, especificacao: {} } });\n}\nreturn saida;"
