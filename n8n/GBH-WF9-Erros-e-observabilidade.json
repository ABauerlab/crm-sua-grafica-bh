        }
      }
    },
    {
      "id": "72a9393c-afd5-43f3-99c4-87ed93db67a1",
      "name": "Custo acima do teto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ec3699fc-a090-4e46-8379-8f73ada7880b",
              "leftValue": "={{ $json.acima === true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
