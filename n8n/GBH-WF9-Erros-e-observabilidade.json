      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://bhlosshvwmlyzhbghsrc.supabase.co/rest/v1/rpc/agente_erro_registrar",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { p_workflow: $json.workflow.name, p_workflow_id: $json.workflow.id, p_no: $json.execution.lastNodeExecuted ?? $json.execution.error?.node?.name ?? \"\", p_mensagem: $json.execution.error?.message ?? \"sem mensagem\", p_execucao: String($json.execution.id ?? \"\") } }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "c9a60770-667c-4132-8ce7-b0c09feff963",
      "name": "Entregar o alerta agora",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://bhlosshvwmlyzhbghsrc.supabase.co/functions/v1/alertas-enviar",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { acao: \"processar\" } }}",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b20ac224-6f43-4343-9b15-91f9a36e676e",
