        "url": "https://bhlosshvwmlyzhbghsrc.supabase.co/functions/v1/produto-fotos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { acao: \"varrer\", topo: $json.topo, pagina: 0 } }}",
        "options": {
          "timeout": 150000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "body",
                    "name": "pagina",
                    "value": "={{ $response.body.proxima }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.proxima === null || $response.body.proxima === undefined }}",
              "limitPagesFetched": true,
              "maxRequests": 200,
              "requestInterval": 0
            }
          }
        },
        "onError": "continueRegularOutput"
      }
    }
