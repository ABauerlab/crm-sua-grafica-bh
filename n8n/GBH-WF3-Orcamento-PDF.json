      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const m = $('Montar orçamento').first().json;\nconst pdf = $('Gerar e enviar PDF').first().json || {};\nlet link = null;\ntry { link = $('Gerar link de pagamento').first().json; } catch (e) { link = null; }\nconst saida = Object.assign({}, m, { pdf: { ok: !!pdf.ok, enviado: !!pdf.enviado, ja_enviado: !!pdf.ja_enviado, motivo: pdf.ok ? undefined : (pdf.motivo || 'erro') } });\nif (pdf.orcamento_id) { saida.orcamento_id = pdf.orcamento_id; saida.numero = pdf.numero || saida.numero; saida.renovado = !!pdf.renovado; }\nif (link) { saida.link_pagamento = link.ok ? { link: link.link, valida_ate: link.valida_ate, texto_curto: link.texto_curto } : { ok: false, motivo: link.motivo, alternativa: link.alternativa }; }\nreturn [{ json: saida }];"
      }
