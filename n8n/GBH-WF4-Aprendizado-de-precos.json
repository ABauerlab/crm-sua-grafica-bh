        "jsCode": "function lerNo(nome) {\n  try { return $(nome).first().json; } catch (e) { return { erro: 'nao_executou' }; }\n}\nconst ajustes = lerNo('Ajustar fator competitivo por grupo');\nconst padroes = lerNo('Detectar padrões incomuns de desconto');\nconst resumo = lerNo('Resumo semanal ao dono');\nreturn [{ json: {\n  executado_em: new Date().toISOString(),\n  condicoes_e_orcamentos_expirados: lerNo('Expirar condições e orçamentos vencidos'),\n  ajustes_de_fator: ajustes.ajustes != null ? ajustes.ajustes : ajustes,\n  alertas_de_padrao: padroes.alertas_criados != null ? padroes.alertas_criados : padroes,\n  texto_do_resumo: resumo.texto || null,\n} }];"
