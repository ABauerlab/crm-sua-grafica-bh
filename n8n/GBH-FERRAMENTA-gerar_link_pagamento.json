      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $('Validar margem e preparar o pedido').first().json;\nconst l = $('Criar link no Mercado Pago').first().json;\nreturn [{ json: { ok: true, link: l.link, valida_ate: l.expira_em || null, texto_curto: p.texto_curto, numero: p.numero } }];"
      }
    },
    {
      "id": "602f37d1-6eb3-51d1-8f57-b6aaf22b18a3",
      "name": "Resposta: sem link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json || {};\nconst motivo = j.motivo || 'erro_ao_criar_link';\nconst textos = {\n  orcamento_vencido: 'O orçamento venceu. Gere um novo orçamento antes de cobrar.',\n  orcamento_encerrado: 'Este orçamento já foi encerrado. Chame o dono.',\n  pedido_ja_pago: 'Este pedido já está pago. Não envie outro link.'\n};\nreturn [{ json: { ok: false, motivo, alternativa: textos[motivo] || 'Não envie o link. Diga que vai confirmar e chame o dono.' } }];"
      }
    }
