        "jsCode": "const r = $input.first().json || {};\nif (r.ok) {\n  return [{ json: { ok: true, orcamento_id: r.orcamento_id, numero: r.numero, enviado: !!r.enviado, ja_enviado: !!r.ja_enviado, renovado: !!r.renovado, reutilizado: !!r.reutilizado } }];\n}\nlet motivo = 'erro';\nif (r.code === 'window_closed') motivo = 'janela_fechada';\nelse if (r.motivo) motivo = String(r.motivo);\nconst alternativa = motivo === 'janela_fechada' ? 'A janela de 24 h fechou. Use um template aprovado para retomar a conversa.' : 'Diga ao cliente que vai confirmar e chame o dono.';\nreturn [{ json: { ok: false, motivo, alternativa } }];"
