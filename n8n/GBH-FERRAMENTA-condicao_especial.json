      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $('Decidir e registrar condição').first().json;\nlet link = null;\nlet erroLink = !!d.order_id;\ntry {\n  const l = $('Criar link de pagamento novo').first().json;\n  link = l.link || null;\n  erroLink = !l.link;\n} catch (e) {\n  link = null;\n}\nreturn [{ json: {\n  tipo: d.tipo,\n  texto_curto: d.texto_curto,\n  valor: Number(d.valor),\n  valida_ate: d.valida_ate,\n  link_pagamento: link,\n  orcamento_id: d.orcamento_id,\n  erro_link: erroLink,\n  pdf_atualizado: false,\n} }];"
      }
    },
