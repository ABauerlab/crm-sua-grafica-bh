<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescreve arquivos e pastas existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback: todo o resto vai para o index.html
  RewriteRule ^ index.html [L]
</IfModule>
