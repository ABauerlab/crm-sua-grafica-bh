# Front-end (apenas valores públicos; nunca coloque segredos aqui)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opcional: e-mail do dono. Se definido, outro e-mail logado é barrado no front (o banco já barra pela tabela app_settings, chave owner).
VITE_ALLOWED_EMAIL=

# Segredos das Edge Functions: cadastrar no painel do Supabase
# (Edge Functions > Secrets), NUNCA neste arquivo.
# WHATSAPP_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_WABA_ID
# META_APP_SECRET
# WHATSAPP_VERIFY_TOKEN
